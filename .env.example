# Copy this file to .env and fill in values.
# LEAVE EVERYTHING BLANK to run in DEMO MODE (no real database or SMS
# needed — this is the fastest way to test and demo the whole project).

# ---------- Server ----------
PORT=5000
CORS_ORIGINS=http://localhost:5000

# ---------- Database (leave blank for demo mode) ----------
# Fill this in once you create a free Supabase project:
#   1. supabase.com -> New project
#   2. Project Settings -> Database -> Connection string (URI, "Transaction" mode)
#   3. Paste it below
# Then run: npm run seed   (creates tables + inserts sample data)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Auth ----------
JWT_SECRET=change_this_to_something_random_before_a_real_demo
JWT_EXPIRES_IN=24h
DEMO_OTP=123456
OTP_TTL_MINUTES=5

# ---------- SMS (Twilio) — leave blank to log to console instead ----------
# Fill in once you have a Twilio trial account:
#   1. twilio.com -> Console -> Account SID + Auth Token
#   2. Buy/use a trial phone number for TWILIO_FROM_NUMBER
#   3. Trial accounts can only text VERIFIED numbers — verify your own
#      phone in the Twilio console before demoing this live.
# Also run: npm install twilio
# Then uncomment the real-Twilio block in src/services/notify.js
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Email (SMTP) — leave blank to log to console instead ----------
# A Gmail "app password" (not your normal password) works fine here:
#   myaccount.google.com/apppasswords
# Also run: npm install nodemailer
# Then uncomment the real-email block in src/services/notify.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
